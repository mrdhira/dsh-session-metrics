# One line ending everywhere. `text=auto` lets git normalise on the way in and
# out, so a clone on any platform gets the same bytes.
* text=auto eol=lf

# Shell scripts must keep LF: a CRLF in a shebang makes the script unrunnable,
# and on macOS that failure is silent until the script is needed.
*.sh text eol=lf

# Binaries: never let git rewrite these.
*.png  binary
*.jpg  binary
*.zst  binary

# Generated: collapse it in diffs and reviews.
pnpm-lock.yaml  -diff linguist-generated
lib/**          linguist-generated