{
  "name": "dsh-session-metrics",
  "version": "1.1.0",
  "private": true,
  "description": "Session cost and billing metrics for the DSH Web GUI: per-provider rates, cost, cache savings, peak/off-peak window, provider and budget \u2014 complementing the shipped stats pills instead of duplicating them.",
  "type": "module",
  "license": "MIT",
  "main": "lib/v1/index.js",
  "exports": {
    ".": {
      "default": "./lib/v1/index.js"
    },
    "./host": {
      "default": "./lib/v1/index.js"
    },
    "./client": {
      "default": "./lib/v1/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "src/**/*.ts",
    "src/**/*.cts",
    "types/**/*.d.ts",
    "build.mjs",
    "tsconfig.json",
    "tsconfig.dynamic.json",
    "scripts/**/*.mjs",
    "cordis.patch.yml",
    "README.md",
    "docs/*.md"
  ],
  "scripts": {
    "guard": "node scripts/guard.mjs",
    "test": "node scripts/guard.mjs --limit-mb 1024 -- node --max-old-space-size=384 --test --test-isolation=none --test-timeout=20000 --test-force-exit \"test/*.test.ts\"",
    "test:fast": "node scripts/guard.mjs --limit-mb 512 -- node --max-old-space-size=256 --test --test-isolation=none --test-timeout=20000 --test-force-exit test/pricing.test.ts test/settings.test.ts test/ledger.test.ts",
    "test:dom": "node scripts/guard.mjs --limit-mb 1024 -- node --max-old-space-size=512 --test --test-isolation=none --test-timeout=20000 --test-force-exit test/client.dom.test.ts test/pricing-page.dom.test.ts",
    "test:replay": "node scripts/guard.mjs --limit-mb 1024 -- node --max-old-space-size=512 --test --test-isolation=none --test-timeout=30000 --test-force-exit test/replay.test.ts",
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.dynamic.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2"
  }
}
