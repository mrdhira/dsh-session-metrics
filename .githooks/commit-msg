#!/usr/bin/env bash
# Reject agent attribution in commit messages.
#
# Dhira's commits are his own: no Co-authored-by, no agent bylines, no
# "Generated with" footer. A trailer is a claim about authorship, and this
# repository makes exactly one such claim.
#
# Bypass deliberately, if ever needed:  git commit --no-verify
set -eu

msg_file="$1"
[ -f "$msg_file" ] || { echo "commit-msg: no message file at '$msg_file'" >&2; exit 1; }

# Trailer keys must START a line: that is the trailer grammar, and it is why a
# commit that merely *documents* these tokens in prose is legitimate. Anchoring
# is not cosmetic — an unanchored match refused this very change for naming the
# trailers it was adding a guard against.
pattern='^[[:space:]]*(co-authored-by|co-developed-by|generated-by|assisted-by|made-with)[[:space:]]*:'
# The free-text footers, end-anchored: they close a message rather than appearing
# mid-sentence, so `Generated with <agent>` in prose is not a byline.
freeform='^[[:space:]]*(generated with[[:space:]]+(claude|codex|copilot|cursor|chatgpt|deepseek)|🤖.*generated).*$'

if grep -inE "$pattern" "$msg_file" >/dev/null 2>&1; then
  echo "commit-msg: REFUSED — an authorship trailer is present:" >&2
  grep -inE "$pattern" "$msg_file" >&2
  echo "This repo credits exactly one author. Remove the trailer, or use --no-verify." >&2
  exit 1
fi

if grep -inE "$freeform" "$msg_file" >/dev/null 2>&1; then
  echo "commit-msg: REFUSED — an agent byline/footer is present:" >&2
  grep -inE "$freeform" "$msg_file" >&2
  echo "This repo credits exactly one author. Remove it, or use --no-verify." >&2
  exit 1
fi

subject="$(head -n1 "$msg_file")"
if [ -z "${subject//[[:space:]]/}" ]; then
  echo "commit-msg: REFUSED — empty subject line." >&2
  exit 1
fi
if [ "${#subject}" -gt 72 ]; then
  echo "commit-msg: note — subject is ${#subject} chars (72 is the working limit)." >&2
fi
exit 0
